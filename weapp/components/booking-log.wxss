/* components/booking-log.wxss */
.footer{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.footer.btns{
    display:flex;
    justify-content:flex-end;
    align-items:center;
}

.footer .time{
  display:flex;
  justify-content:flex-start;
  align-items:center;
  flex-wrap: nowrap;
  font-size:24rpx;
}

/* 报备信息样式 */
.info-row {
  display: flex;
  margin-bottom: 10rpx;
  font-size: 28rpx;
}

.info-row .label {
  color: #666;
  min-width: 140rpx;
}

.info-row .value {
  color: #333;
  flex: 1;
}
